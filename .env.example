# REQUIRED. Public origin of the marketplace, no trailing slash, e.g. https://www.example.com.
# Every link back to the marketplace, canonical URLs, the sitemap and company subdomains
# (abc-rental.example.com) are built from it. A production build fails without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED. Backend API base URL, including the version prefix, e.g. https://api.example.com/api/v1
# (http://localhost:8000/api/v1 for a local backend). Vehicle and company lists stay empty without it.
NEXT_PUBLIC_API_URL=

# Optional. Address of the user portal where rental companies sign up and sign in,
# e.g. https://app.example.com. "Start free trial" and "Company sign in" stay hidden without it.
NEXT_PUBLIC_PORTAL_URL=

# Optional. Address where a rental company books a session with the team, e.g. a scheduling page.
# "Talk to sales" falls back to the support email without it.
NEXT_PUBLIC_DEMO_URL=

# Optional. Support address behind the footer's Contact link, e.g. help@example.com.
# The link stays hidden without it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe publishable key of the platform account (pk_live_... or pk_test_...), the same one
# the user portal uses. Renters cannot pay on /pay/<token> links without it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Google Maps key, with the Maps Embed API (location maps) and the Maps JavaScript API
# (search map) enabled. Empty falls back to the keyless embed and hides the search map.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional. Google Maps Map ID (type JavaScript) for the search map's price pins.
# Empty uses Google's demo ID, which is for development only.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional. Sentry error tracking. Empty disables it.
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Only for uploading source maps to Sentry during the build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional. PostHog analytics. Empty disables it.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Only for PostHog's EU cloud or a self-hosted instance; defaults to the US cloud.
NEXT_PUBLIC_POSTHOG_HOST=
