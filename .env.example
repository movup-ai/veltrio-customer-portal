# Public origin of the marketplace, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Host that company subdomains hang off (abc-rental.<root>). Defaults to the host of the site URL.
NEXT_PUBLIC_ROOT_DOMAIN=

# REQUIRED. Backend API base URL, including the version prefix, e.g. https://api.example.com/api/v1
# (http://localhost:8000/api/v1 for a local backend). Vehicle and company lists stay empty without it.
NEXT_PUBLIC_API_URL=

# Sentry (error tracking). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (analytics). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
